    "check": "yarn run test",
    "fetch:bin": "node scripts/fetch-tintin-binaries.mjs",
    "fetch:ext": "node scripts/fetch-tintin-ext-assets.mjs"
  },
  "devDependencies": {
    "adm-zip": "^0.6.0",
    "dsh-tintin-bundle": "0.1.0-dev.0",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  }
}
