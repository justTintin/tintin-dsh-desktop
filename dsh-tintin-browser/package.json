{
  "name": "dsh-tintin-browser",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "TinTin browser domain: independent browser windows, platform extractors, downloads, and auto-listing (pure logic + Electron-main modules consumed by the TinTin desktop channel)",
  "exports": {
    ".": "./src/browser/browser-service.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
