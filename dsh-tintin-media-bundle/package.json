{
  "name": "dsh-tintin-media-bundle",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "TinTin media tools: Vue sub-application (media cards, storyboard montage, material library) mounted through the dsh client module seam",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "check": "yarn run build && yarn run test"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "plyr": "^3.8.4",
    "vite": "^7.0.0",
    "vitest": "4.1.8",
    "vue": "^3.5.43"
  }
}
