{
  "name": "dsh-tintin-cover-plugin",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "TinTin 封面制作插件(需求文档 docs/cover-generation-requirements.md)。2026-10-30 用户裁决:第三层独立插件——声明 dsh.client 经 cordis.patch.yml 挂载,宿主入口(index.js)承载会话桥/路由/工具组,web 入口(client.js)自注册封面视图;Remotion 引擎与编辑器载荷仍走通道 tintin-resources/cover-plugin staging,与本入口解耦(WP-1 收尾项就此清偿)。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:editor": "vite build",
    "build:engine": "esbuild src/engine.ts --bundle --format=esm --platform=node --outfile=dist/engine.mjs --external:@remotion/bundler --external:@remotion/renderer --external:remotion --log-level=warning",
    "build:bundle": "node scripts/build-bundle.mjs",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/player": "4.0.539",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.28.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "zundo": "2.3.0",
    "zustand": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
